# Salin file ini menjadi .env lalu isi nilainya bila perlu.
# Ketiganya OPSIONAL — tanpa .env sama sekali aplikasi sudah berjalan benar
# selama backend Sifp_Vue.Server aktif di http://localhost:5250.

# Alamat backend yang dituju proxy dev server (lihat vite.config.js).
# Isi bila `dotnet run` memakai port selain 5250.
VITE_API_PROXY=http://localhost:5250

# Prefix absolut untuk seluruh panggilan API.
# Biarkan KOSONG agar memakai origin yang sama:
#   - saat dev  -> /api diteruskan proxy Vite ke VITE_API_PROXY
#   - saat build-> Vue disajikan dari wwwroot backend, jadi satu origin
# Isi (mis. https://sifp.example.com) hanya bila frontend dan backend
# benar-benar di-deploy pada domain berbeda; pastikan domainnya juga terdaftar
# pada Cors:AllowedOrigins di appsettings.json backend.
VITE_API_BASE=

# Endpoint penerima import Excel (halaman /import).
# Bawaannya `${VITE_API_BASE}/api/import/excel`; isi hanya bila workbook harus
# dikirim ke layanan lain. Dikirim sebagai POST multipart/form-data:
#   file    -> file .xlsx asli yang diunggah user, TIDAK diubah sama sekali
#   summary -> JSON ringkasan (nama file, jumlah sheet, jumlah baris, jumlah edit)
#   edits   -> JSON array perubahan sel dari preview, contoh:
#              [{ "sheet":"ANALYZE-TOP5", "excelRow":3, "excelCol":4,
#                 "cell":"D3", "from":"4", "to":"5" }]
#              Backend yang menerapkan edits ke file asli. Perubahan sengaja
#              tidak ditimpakan di browser agar rumus, format, dan merge cell
#              pada workbook asli tidak hilang.
VITE_IMPORT_ENDPOINT=
