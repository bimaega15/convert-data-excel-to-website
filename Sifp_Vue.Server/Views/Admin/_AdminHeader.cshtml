<header class="admin-header">
    <div>
        <h1 class="admin-title">@ViewData["Title"]</h1>
        @if (ViewData["Subtitle"] is string subtitle && !string.IsNullOrWhiteSpace(subtitle))
        {
            <p class="admin-subtitle">@subtitle</p>
        }
    </div>

    <div class="admin-user">
        <div class="admin-user-info">
            <span class="admin-user-name">@(User.FindFirst("full_name")?.Value ?? User.Identity?.Name)</span>
            <span class="admin-user-role">@string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</span>
        </div>
        <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">Keluar</button>
        </form>
    </div>
</header>
