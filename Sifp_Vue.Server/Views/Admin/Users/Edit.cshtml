@model UserFormViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["Subtitle"] = $"Users · {Model.Username}";
}

<div class="admin-card">
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Username" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Username</label>
                <input class="form-control" value="@Model.Username" disabled />
                <span class="form-text">Username tidak dapat diubah setelah akun dibuat.</span>
            </div>
            <div class="col-md-4">
                <label asp-for="EditForm.FullName" class="form-label">Nama Lengkap</label>
                <input asp-for="EditForm.FullName" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="EditForm.Email" class="form-label">Email</label>
                <input asp-for="EditForm.Email" type="email" class="form-control" />
                <span asp-validation-for="EditForm.Email" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EditForm.NewPassword" class="form-label">Password Baru</label>
                <input asp-for="EditForm.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span class="form-text">Kosongkan bila password tidak diubah.</span>
                <span asp-validation-for="EditForm.NewPassword" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="EditForm.Zona" class="form-label">Zona</label>
                <input asp-for="EditForm.Zona" type="number" min="1" max="99" class="form-control" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="EditForm.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="EditForm.IsActive" class="form-check-label">Akun aktif</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Role</label>
                <div class="role-list">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="EditForm.RoleIds" value="@role.Id"
                                   id="role-@role.Id" checked="@Model.EditForm.RoleIds.Contains(role.Id)" />
                            <label class="form-check-label" for="role-@role.Id">
                                <strong>@role.Name</strong>
                                <span class="text-muted small d-block">@role.Description</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Simpan</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Batal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
