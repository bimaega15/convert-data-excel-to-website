@model UserFormViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["Subtitle"] = "Users";
}

<div class="admin-card">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CreateForm.Username" class="form-label">Username <span class="text-danger">*</span></label>
                <input asp-for="CreateForm.Username" class="form-control" autocomplete="off" />
                <span asp-validation-for="CreateForm.Username" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CreateForm.FullName" class="form-label">Nama Lengkap</label>
                <input asp-for="CreateForm.FullName" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="CreateForm.Email" class="form-label">Email</label>
                <input asp-for="CreateForm.Email" type="email" class="form-control" />
                <span asp-validation-for="CreateForm.Email" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateForm.Password" class="form-label">Password <span class="text-danger">*</span></label>
                <input asp-for="CreateForm.Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="CreateForm.Password" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="CreateForm.Zona" class="form-label">Zona</label>
                <input asp-for="CreateForm.Zona" type="number" min="1" max="99" class="form-control" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="CreateForm.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="CreateForm.IsActive" class="form-check-label">Akun aktif</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Role</label>
                <div class="role-list">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="CreateForm.RoleIds" value="@role.Id" id="role-@role.Id" />
                            <label class="form-check-label" for="role-@role.Id">
                                <strong>@role.Name</strong>
                                <span class="text-muted small d-block">@role.Description</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Simpan</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Batal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
