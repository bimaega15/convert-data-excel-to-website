@model InitiativeFormViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["Subtitle"] = $"Improvement Initiatives · {Model.Form.ImprovementCode}";
}

<div class="admin-card">
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        @* Path lengkap: pencarian partial memakai nama controller, bukan folder view. *@
        <partial name="~/Views/Admin/Initiatives/_Form.cshtml" model="Model" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
