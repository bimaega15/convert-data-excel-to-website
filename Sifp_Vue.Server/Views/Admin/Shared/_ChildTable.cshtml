@model ChildTableViewModel

<div class="admin-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="admin-card-title mb-0">@Model.Title</h2>
        <span class="text-muted small">@Model.Rows.Count baris</span>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <partial name="~/Views/Admin/Shared/_EmptyState.cshtml"
                 model="@($"Tidak ada {Model.Title.ToLowerInvariant()} untuk observasi ini.")" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        @foreach (var header in Model.Headers)
                        {
                            <th>@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td class="cell-clamp" title="@cell">@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
