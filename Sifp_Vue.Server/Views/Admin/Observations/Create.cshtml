@model ObservationFormViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["Subtitle"] = "Observations";
}

<div class="admin-card">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        @* Path lengkap: pencarian partial memakai nama controller, bukan folder view. *@
        <partial name="~/Views/Admin/Observations/_Form.cshtml" model="Model" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
