{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "SifpDatabase": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },

  "Jwt": {
    "Issuer": "SifpAssurance",
    "Audience": "SifpAssurance.Client",
    "ExpiryMinutes": 480,
    "RememberMeExpiryMinutes": 20160,
    "SigningKey": ""
  },

  "Auth": {
    "AllowedEmailDomains": [ "pertamina.com" ],
    "ClientBaseUrl": "",
    "AutoProvision": true,
    "AutoProvisionRole": "Viewer"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc"
  },

  "Import": {
    "MaxFileSizeMb": 25,
    "AllowedExtensions": [ ".xlsx", ".xlsm" ]
  },

  "Seed": {
    "AutoMigrate": true,
    "RunSeeders": true,
    "SeedSampleData": true,
    "GeneratedDataPath": "../sifp_vue.client/src/data/generated",
    "AdminUsername": "admin",
    "AdminEmail": "admin@pertamina.com",
    "AdminFullName": "Administrator",
    "AdminPassword": ""
  }
}
