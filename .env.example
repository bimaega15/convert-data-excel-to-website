# Salin file ini menjadi .env lalu isi nilainya.

# Endpoint backend penerima import Excel (halaman /import).
# Dikirim sebagai POST multipart/form-data dengan dua field:
#   file    -> file .xlsx asli yang diunggah user
#   summary -> JSON ringkasan (nama file, jumlah sheet, jumlah baris per sheet)
# Selama variabel ini kosong, tombol submit akan memberi tahu bahwa endpoint
# belum dikonfigurasi dan file TIDAK dikirim ke mana pun.
VITE_IMPORT_ENDPOINT=
